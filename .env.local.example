# =====================================================================
# 에임브릿지 인트라넷 환경변수 템플릿
# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.  cp .env.local.example .env.local
# .env.local 은 절대 git에 커밋하지 않습니다(.gitignore에 이미 포함).
# =====================================================================

# --- Supabase -------------------------------------------------------
# Supabase 대시보드 > Project Settings > API 에서 확인
# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# anon / public 키 (또는 신규 프로젝트의 Publishable key: sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role 키 (또는 Secret key: sb_secret_...) — 서버에서만 사용, 절대 노출 금지
SUPABASE_SERVICE_ROLE_KEY=

# --- 로그인 도메인 제한 ---------------------------------------------
# 기획서 3.1: sding.kr 도메인 계정만 로그인 허용
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=sding.kr
# Google 계정 선택창을 해당 워크스페이스로 제한(hd 파라미터)
NEXT_PUBLIC_GOOGLE_HOSTED_DOMAIN=sding.kr

# --- 시딩 (npm run seed) --------------------------------------------
# 최초 시스템 관리자 계정. 본인(PM) 회사 이메일을 넣으세요.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
# (선택) 초기 부서 목록. 콤마로 구분. 비워두면 부서를 만들지 않습니다.
SEED_DEPARTMENTS=
